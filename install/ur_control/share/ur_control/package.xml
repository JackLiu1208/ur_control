<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_control</name>
  <version>0.1.0</version>
  <description>
    UR arm joint-space / Cartesian control node. Joint commands are sent via the same
    FollowJointTrajectory action interface used by the official Universal_Robots_ROS2_Driver
    external-control examples; Cartesian targets are planned with MoveIt2 and executed through
    the same controller, so the on-wire communication path matches the officially tested setup.
  </description>
  <maintainer email="804jack@gmail.com">jackliu1017</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- dp_control_rtde.py also needs the ur_rtde PyPI package (rtde_control /
       rtde_receive), not a ROS package; see README.md for the pip install command -->
  <!-- analytic_ik.py needs the ur-analytic-ik PyPI package (PickNik IKFast closed-form
       UR solver), not a ROS package; see README.md for the pip install command -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
